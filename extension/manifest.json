{
  "manifest_version": 3,
  "name": "职聘通·网申助手",
  "version": "1.0.0",
  "description": "在任意企业官网投递页一键自动填写个人信息。画像从职聘通网站同步，一处完善处处可用。数据仅存本地，不上传。",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "职聘通·网申助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
